---
layout: default
---
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  <style>
    /* CV 条目样式调整（仅作用于 /cv/ 页面）：
       - 学位名、时间：不加粗
       - 学校名称：加粗（不再作为链接，已在 _data/cv.yml 中移除 url） */
    .cv li.list-group-item h6.title.font-weight-bold { font-weight: normal !important; }
    .cv li.list-group-item h6:nth-of-type(2) { font-weight: bold !important; }
    .cv .date-column .badge.font-weight-bold { font-weight: normal !important; }
  </style>
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
